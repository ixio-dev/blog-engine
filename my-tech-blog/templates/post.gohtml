{{define "content"}}
<article class="post">
  <header class="fixed-post-header">
    <h1 class="post-title">{{.Post.Title}}</h1>
    <div class="post-meta">
      <time datetime="{{.Post.Date}}">{{.Post.DatePretty}}</time>
      {{if .Post.Tags}}
      <span class="tags">
        {{range $index, $tag := .Post.Tags}}<a href="{{$.BaseURL}}/tags/{{slugify $tag}}/" class="tag">{{$tag}}</a>{{if not (isLast $.Post.Tags $index)}}, {{end}}{{end}}
      </span>
      {{end}}
      {{if .Post.Draft}}<span class="badge draft">Draft</span>{{end}}
    </div>
  </header>

  <div class="post-body-container">
    <div class="post-body">
      {{.Post.HTML}}
    </div>
  </div>

  <footer class="post-footer">
    <nav class="post-nav">
      {{if .NextPost}}
      <div class="post-nav-item prev-post">
        <span class="nav-label">Previous Post:</span>
        <a href="{{.NextPost.URL}}" class="prev">{{.NextPost.Title}}</a>
      </div>
      {{end}}
      {{if .PrevPost}}
      <div class="post-nav-item next-post">
        <span class="nav-label">Next Post:</span>
        <a href="{{.PrevPost.URL}}" class="next">{{.PrevPost.Title}}</a>
      </div>
      {{end}}
    </nav>
  </footer>
</article>
{{end}}