{{define "content"}}
<section class="tag-page">
  <h1>Tag: {{.Tag}}</h1>
  <ul class="post-list">
    {{range .Posts}}
    <li class="post-list-item">
      <a class="post-link" href="{{$.BaseURL}}/posts/{{.Slug}}/">
        <h2 class="post-title">{{.Title}}</h2>
      </a>
      <div class="post-meta">
        <time datetime="{{.Date}}">{{.DatePretty}}</time>
      </div>
    </li>
    {{end}}
  </ul>
</section>
{{end}}